            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Valeur"
        },
        "provenance": {
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        },
        "couverture": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Couverture",
          "type": "number"
